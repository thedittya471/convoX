BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=

# Existing SMTP provider: STARTTLS on 587, or implicit TLS on 465.
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_FROM=verified-sender@your-domain.example
SMTP_USER=
SMTP_PASSWORD=
# For isolated local Mailpit only: host localhost (pnpm dev) or mailpit (Compose),
# port 1025, SMTP_TLS=local, SMTP_FROM=convox@example.com, no credentials.
