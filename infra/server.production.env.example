# Copy outside the repository. Fill secrets using your deployment secret mechanism.
BETTER_AUTH_URL=https://chat.your-domain.example
BETTER_AUTH_SECRET=
METRICS_TOKEN=
DATABASE_URL=postgresql://convox:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/convox
REDIS_URL=redis://default:REPLACE_WITH_URL_ENCODED_PASSWORD@redis:6379
# Must match the production edge subnet; omit broad development network trust.
TRUSTED_PROXY_CIDRS=172.30.0.0/24
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_FROM=verified-sender@your-domain.example
SMTP_USER=
SMTP_PASSWORD=
SOCKET_USER_LIMIT=10
SOCKET_IP_LIMIT=100
SOCKET_OUTBOUND_BYTES=262144
CHAT_IP_PER_MINUTE=300
CHAT_SENDS_PER_MINUTE=120
CHAT_LOOKUPS_PER_MINUTE=60
CHAT_OPENS_PER_MINUTE=30
CHAT_READS_PER_MINUTE=120
