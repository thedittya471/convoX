{
  "name": "convox",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @convox/contracts build && turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test && node --test tests/load/accounting.test.mjs",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "stack:up": "docker compose --profile stack up -d --build --wait --wait-timeout 120",
    "stack:down": "docker compose --profile stack down",
    "test:smoke": "node tests/integration/smoke.mjs",
    "test:auth": "docker compose exec -T server-1 node tests/integration/auth.mjs && docker compose exec -T server-1 node tests/integration/password-reset.mjs",
    "test:conversations": "docker compose exec -T server-1 node tests/integration/conversations.mjs",
    "test:messages": "node tests/integration/messages.mjs",
    "test:realtime": "node tests/integration/realtime.mjs",
    "test:client-sync": "node tests/integration/client-sync.mjs",
    "db:generate": "pnpm --filter @convox/server db:generate",
    "db:migrate": "pnpm --filter @convox/server db:migrate",
    "test:presence": "node tests/integration/activity.mjs",
    "test:typing": "node tests/integration/activity.mjs typing",
    "validate:production": "node scripts/validate-production.mjs",
    "test:production": "node tests/config/production.mjs",
    "test:gateway": "node tests/integration/gateway.mjs",
    "test:metrics": "docker compose exec -T server-2 node tests/integration/metrics.mjs",
    "test:sockets": "docker compose exec -T server-2 node tests/integration/socket-limits.mjs",
    "test:limits": "docker compose exec -T server-2 node tests/integration/rate-limits.mjs",
    "db:backup": "node scripts/database-backup.mjs backup",
    "db:restore": "node scripts/database-backup.mjs restore",
    "test:backup": "node tests/operations/backup.mjs",
    "test:outages": "node tests/integration/dependency-outage.mjs",
    "test:load": "node --test tests/load/accounting.test.mjs",
    "load": "node tests/load/run.mjs",
    "test:security": "node tests/security/compressed-body.mjs",
    "test:api-reference": "docker compose exec -T server-2 node tests/integration/api-reference.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.28.6",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "turbo": "^2.11.9",
    "typescript": "5.9.3"
  }
}
