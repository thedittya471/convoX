# Copy to .env.production (gitignored). Images must be reviewed immutable digests.
PUBLIC_HOST=chat.your-domain.example
EDGE_SUBNET=172.30.0.0/24
NODE_IMAGE=node@sha256:REPLACE_WITH_REVIEWED_NODE_24_DIGEST
SERVER_IMAGE=registry.your-domain.example/convox-server@sha256:REPLACE_WITH_RELEASE_DIGEST
WEB_IMAGE=registry.your-domain.example/convox-web@sha256:REPLACE_WITH_RELEASE_DIGEST
POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_REVIEWED_POSTGRES_17_DIGEST
REDIS_IMAGE=redis@sha256:REPLACE_WITH_REVIEWED_REDIS_8_DIGEST
NGINX_IMAGE=nginx@sha256:REPLACE_WITH_REVIEWED_NGINX_DIGEST
SERVER_ENV_FILE=/srv/convox/secrets/server.env
DATABASE_PASSWORD_FILE=/srv/convox/secrets/database_password
REDIS_ACL_FILE=/srv/convox/secrets/redis.acl
TLS_CERTIFICATE_FILE=/srv/convox/secrets/tls.crt
TLS_PRIVATE_KEY_FILE=/srv/convox/secrets/tls.key
